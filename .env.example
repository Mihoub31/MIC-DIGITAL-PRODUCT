# Copy this file to .env and fill in the values. Never commit .env.

# Runtime
NODE_ENV=development
PORT=3002
APP_ORIGIN=http://localhost:3000
# Comma-separated additional allowed origins (e.g. https://creatorpilot.app)
EXTRA_ORIGINS=
# Set to true only when the app runs behind Render or another reverse proxy
TRUST_PROXY=false

# Database
DATABASE_URL=
# Development/testing database used by: npm run db:migrate:backup
BACKUP_DATABASE_URL=
# Leave empty for local Postgres; set false to disable SSL explicitly
DATABASE_SSL=

# Sessions
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
SESSION_DAYS=7

# Passwords
BCRYPT_ROUNDS=12

# Email (optional). Without a provider, password reset links are only written to the server log.
SMTP_URL=
RESEND_API_KEY=
